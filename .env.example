# Copy to .env.local and fill in
# Initial admin password (used once to create the password hash; change it later in Admin → Settings → Security)
ADMIN_PASSWORD=
# Local http testing of a production build ONLY (set it for both `next build` and `next start`); ignored for
# https / public hosts. Leave empty in production.
ADMIN_INSECURE_COOKIE=
# Number of reverse proxies in front of Next (nginx = 1, Cloudflare -> nginx = 2). Used to read the real client IP.
TRUST_PROXY_HOPS=1
# Public site URL: canonical links, sitemap, JSON-LD and share images
NEXT_PUBLIC_SITE_URL=https://example.com
