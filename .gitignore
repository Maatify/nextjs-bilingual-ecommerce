/.lighthouseci/

# playwright
/test-results/
/playwright-report/

# image optimizer report (scripts/optimize-images.mjs)
/_image_report.csv

# local assistant notes (kept out of the repo)
CLAUDE.md
AGENTS.md
.claude/
