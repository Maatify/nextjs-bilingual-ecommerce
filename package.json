{
  "name": "nextjs-bilingual-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:snapshot": "node scripts/db-snapshot.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./tests/setup/register.mjs --test \"tests/**/*.test.ts\"",
    "test:smoke": "node scripts/smoke.mjs",
    "security:check": "npm audit --omit=dev && node scripts/security-tests.mjs --safe",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:site": "node scripts/site-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && next build",
    "lighthouse": "lhci autorun",
    "prepare": "husky || true",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "calc-s2-rust": "1.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright-core": "1.64.1",
    "svgo": "4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{ts,tsx}": "bash -c 'next typegen && tsc --noEmit'"
  }
}
